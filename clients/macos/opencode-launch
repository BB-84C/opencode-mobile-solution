#!/bin/zsh

# opencode-relay-managed-client v1
setopt pipe_fail
source "${OPENCODE_RELAY_LIB_DIR:-$HOME/.local/lib/opencode-relay}/common.sh" || exit 10
relay_load_config || exit $?

local_mode=false
directory="$PWD"
typeset -a forward
while (( $# > 0 )); do
  case "$1" in
    --local)
      local_mode=true
      shift
      ;;
    --dir)
      (( $# >= 2 )) || { print -u2 -- '--dir requires a directory.'; exit 10; }
      directory="$2"
      shift 2
      ;;
    --dir=*)
      directory="${1#--dir=}"
      shift
      ;;
    *)
      forward+=("$1")
      shift
      ;;
  esac
done

if $local_mode; then
  exec env -u OPENCODE_SERVER_USERNAME -u OPENCODE_SERVER_PASSWORD "$RELAY_REAL_OPENCODE" "${forward[@]}"
fi

if ! relay_probe; then
  # Bare interactive launch owns only the local backend bootstrap. It must not
  # block on OAuth or silently create an independent fallback process.
  "$RELAY_CONTROLLER" start backend >/dev/null 2>&1 || true
fi

if ! relay_probe; then
  print -u2 -- "OpenCode shared backend at $RELAY_HOST:$RELAY_PORT is unavailable."
  print -u2 -- 'No independent process was started. Use `opencode --local` for the explicit escape hatch.'
  exit 7
fi

state=$(relay_read_state 2>/dev/null) || { print -u2 -- 'Relay attach requires the current READY generation.'; exit 6; }
[[ "$(jq -r '.state' <<< "$state")" == READY ]] || { print -u2 -- 'Relay attach requires the current READY generation.'; exit 6; }
generation=$(jq -r '.generation' <<< "$state")
attach_args=(attach "http://$RELAY_HOST:$RELAY_PORT" --dir "$directory" "${forward[@]}")

export OPENCODE_REAL_CMD="$RELAY_REAL_OPENCODE"
export OPENCODE_CONTROLLER="$RELAY_CONTROLLER"
export OPENCODE_CLIENT_DIRECTORY="$directory"
export OPENCODE_CLIENT_GENERATION="$generation"
export OPENCODE_SERVER_USERNAME
export OPENCODE_SERVER_PASSWORD
exec "$RELAY_NODE" "$RELAY_LIB_DIR/opencode-client-launcher.mjs" "${attach_args[@]}"
