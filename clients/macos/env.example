# Copy to ~/.config/opencode-relay/env, replace every placeholder, then chmod 600.
# install.sh creates this file with a random Basic-auth password on first install.
OPENCODE_SERVER_PORT=4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-at-least-32-random-bytes
OPENCODE_RELAY_ORIGIN=https://opencode.example.com
OPENCODE_RELAY_SSH_ALIAS=opencode-vps

# Optional. This is a phone/device bearer used only for an end-to-end public
# health probe. Machine OAuth credentials cannot authenticate proxy traffic.
# OPENCODE_RELAY_PROBE_TOKEN=replace-with-a-device-bearer

# Optional path overrides.
# OPENCODE_FRPC_BIN=$HOME/.local/lib/opencode-relay/bin/frpc
