#!/bin/zsh

# opencode-relay-managed-client v1
setopt pipe_fail
source "${OPENCODE_RELAY_LIB_DIR:-$HOME/.local/lib/opencode-relay}/common.sh" || exit 10
relay_load_config || exit $?

action="${1:-status}"
json=false
[[ "${2:-}" == --json ]] && json=true
AGENT_MODULE="$RELAY_LIB_DIR/opencode-machine-agent.mjs"
AGENT_STATE="$RELAY_STATE_ROOT/machine-agent-process.json"
AGENT_STATUS="$RELAY_STATE_ROOT/machine-agent-status.json"
MACHINE_CREDENTIAL="$RELAY_CONFIG_DIR/machine.json"

agent_state_read() {
  [[ -f "$AGENT_STATE" ]] || return 1
  jq -e '(.schema == 1) and (.process.pid > 0)' "$AGENT_STATE" >/dev/null 2>&1 || return 1
  jq -c . "$AGENT_STATE"
}

agent_running() {
  local state="$1"
  relay_process_matches "$(jq -c '.process' <<< "$state")"
}

agent_status_json() {
  local runtime="Stopped" pid=null state latest='null'
  if state=$(agent_state_read 2>/dev/null); then
    pid=$(jq -r '.process.pid' <<< "$state")
    if agent_running "$state"; then runtime="Running"; else runtime="Stale"; fi
  fi
  if [[ -f "$AGENT_STATUS" ]]; then
    latest=$(jq -c . "$AGENT_STATUS" 2>/dev/null || print -r -- null)
  fi
  jq -cn --arg Status "$runtime" --argjson PID "$pid" --argjson Heartbeat "$latest" '{Status:$Status,PID:$PID,Heartbeat:$Heartbeat}'
}

start_agent() {
  local state
  if state=$(agent_state_read 2>/dev/null); then
    if agent_running "$state"; then return 0; fi
    rm -f "$AGENT_STATE"
  fi
  [[ -x "$RELAY_NODE" && -f "$AGENT_MODULE" && -f "$MACHINE_CREDENTIAL" ]] || return 10
  local launch_id envelope handshake pid process tmp
  launch_id="$(date +%Y%m%dT%H%M%S)-$$-$RANDOM"
  envelope=$(jq -cn --arg executable "$RELAY_NODE" --arg module "$AGENT_MODULE" \
    --arg stdoutPath "$RELAY_LOG_ROOT/machine-agent-$launch_id.stdout.log" \
    --arg stderrPath "$RELAY_LOG_ROOT/machine-agent-$launch_id.stderr.log" \
    '{executable:$executable,args:[$module],stdoutPath:$stdoutPath,stderrPath:$stderrPath}') || return 10
  handshake=$(print -r -- "$envelope" | OPENCODE_SERVER_USERNAME="$OPENCODE_SERVER_USERNAME" OPENCODE_SERVER_PASSWORD="$OPENCODE_SERVER_PASSWORD" "$RELAY_NODE" "$RELAY_DAEMON_LAUNCHER") || return 7
  pid=$(jq -r '.pid // 0' <<< "$handshake" 2>/dev/null)
  [[ "$pid" == <1-> ]] || return 7
  sleep 0.3
  process=$(relay_process_json "$pid") || return 7
  tmp=$(mktemp "$RELAY_STATE_ROOT/.machine-agent-process.XXXXXX") || return 10
  chmod 600 "$tmp"
  jq -cn --argjson process "$process" '{schema:1,process:$process}' > "$tmp"
  mv -f "$tmp" "$AGENT_STATE"
}

stop_agent() {
  local state process
  state=$(agent_state_read 2>/dev/null) || { rm -f "$AGENT_STATE"; return 0; }
  process=$(jq -c '.process' <<< "$state")
  if relay_process_matches "$process"; then relay_kill_verified_group "$process" 8 || return $?; fi
  rm -f "$AGENT_STATE"
}

case "$action" in
  start) start_agent || exit $? ;;
  stop) stop_agent || exit $? ;;
  restart) stop_agent || exit $?; start_agent || exit $? ;;
  status) ;;
  *) print -u2 -- "Unsupported machine agent action: $action"; exit 10 ;;
esac

result=$(agent_status_json)
if $json; then
  print -r -- "$result"
else
  print -r -- "Status: $(jq -r '.Status' <<< "$result")"
fi
[[ "$action" == stop ]] && exit 0
[[ "$(jq -r '.Status' <<< "$result")" == Running ]] && exit 0
exit 3
