#!/bin/zsh

# opencode-relay-managed-wrapper v1
# install.sh replaces the token below with a JSON-quoted absolute path.
REAL_OPENCODE="__OPENCODE_REAL_CMD__"
BIN_DIRECTORY="${OPENCODE_RELAY_BIN_DIR:-$HOME/.local/bin}"
CONTROLLER="$BIN_DIRECTORY/opencode-relay-server"
LAUNCHER="$BIN_DIRECTORY/opencode-launch"

if [[ ! -x "$REAL_OPENCODE" ]]; then
  print -u2 -- "The original OpenCode executable is unavailable: $REAL_OPENCODE"
  exit 10
fi
if [[ "$REAL_OPENCODE" -ef "$0" ]]; then
  print -u2 -- 'OpenCode wrapper recursion was detected; run the macOS installer doctor command.'
  exit 10
fi

if [[ "${1:-}" == --relay_server ]]; then
  shift
  exec "$CONTROLLER" "$@"
fi

if [[ "${1:-}" == --local ]]; then
  shift
  exec /usr/bin/env -u OPENCODE_SERVER_USERNAME -u OPENCODE_SERVER_PASSWORD "$REAL_OPENCODE" "$@"
fi

case "${1:-}" in
  ''|--dir|--dir=*|--continue|-c|--session|-s|--fork|--mini)
    exec "$LAUNCHER" "$@"
    ;;
  *)
    exec /usr/bin/env -u OPENCODE_SERVER_USERNAME -u OPENCODE_SERVER_PASSWORD "$REAL_OPENCODE" "$@"
    ;;
esac
