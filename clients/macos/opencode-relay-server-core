#!/bin/zsh

# opencode-relay-managed-client v1
setopt pipe_fail
source "${OPENCODE_RELAY_LIB_DIR:-$HOME/.local/lib/opencode-relay}/common.sh" || exit 10
relay_load_config || exit $?

action="${1:-status}"
target="backend"
json=false
shift $(( $# > 0 ? 1 : 0 ))
if [[ "$action" != __register && "$action" != __unregister ]]; then
  for argument in "$@"; do
    case "$argument" in
      backend|tunnel) target="$argument" ;;
      --json) json=true ;;
      *) print -u2 -- "Unsupported relay argument: $argument"; exit 10 ;;
    esac
  done
fi

emit_result() {
  local result="$1" code="$2"
  if $json; then
    print -r -- "$result"
  else
    local summary
    summary=$(jq -r 'if has("State") then "State: " + (.State|tostring) elif has("Status") then "Status: " + (.Status|tostring) else "Relay command completed." end' <<< "$result")
    print -r -- "$summary"
    jq -r '.Warnings[]? | "- " + .' <<< "$result" | while IFS= read -r line; do print -r -- "$line"; done
  fi
  exit "$code"
}

emit_error() {
  local message="$1" code="$2"
  if $json; then
    local safe="Relay command failed."
    [[ "$message" == *deadline* ]] && safe="Relay lifecycle deadline expired."
    [[ "$message" == *ownership* ]] && safe="Relay ownership conflict."
    [[ "$message" == *start*failed* ]] && safe="Relay backend start failed."
    jq -cn --arg Error "$safe" '{State:"Error",Error:$Error,Warnings:[$Error]}'
  else
    print -u2 -- "$message"
  fi
  exit "$code"
}

if [[ "$action" == __register ]]; then
  pid="${1:-0}" generation="${2:-0}" directory="${3:-}"
  [[ "$pid" == <1-> && "$generation" == <1-> && -n "$directory" ]] || exit 10
  relay_lock_acquire 20 || exit $?
  trap relay_lock_release EXIT
  state=$(relay_read_state) || exit 6
  [[ "$(jq -r '.state' <<< "$state")" == READY && "$(jq -r '.generation' <<< "$state")" == "$generation" ]] || exit 6
  process=$(relay_process_json "$pid") || exit 6
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  lease=$(jq -cn --argjson process "$process" --argjson generation "$generation" --arg directory "$directory" --arg now "$now" \
    '$process | {schema:1,pid,parentPid,created,executable,pgid} + {backendGeneration:$generation,directory:$directory,sessionID:null,lastHeartbeatUtc:$now}')
  tmp=$(mktemp "$RELAY_CLIENT_ROOT/.$pid.XXXXXX") || exit 10
  chmod 600 "$tmp"
  print -r -- "$lease" > "$tmp"
  mv -f "$tmp" "$RELAY_CLIENT_ROOT/$pid.json"
  print -r -- "$lease"
  exit 0
fi

if [[ "$action" == __unregister ]]; then
  pid="${1:-0}" created="${2:-}"
  [[ "$pid" == <1-> && -n "$created" ]] || exit 10
  relay_lock_acquire 20 || exit $?
  trap relay_lock_release EXIT
  lease_path="$RELAY_CLIENT_ROOT/$pid.json"
  if [[ -f "$lease_path" ]]; then
    current=$(jq -c . "$lease_path" 2>/dev/null) || exit 6
    [[ "$(jq -r '.pid' <<< "$current")" == "$pid" && "$(jq -r '.created' <<< "$current")" == "$created" ]] || exit 6
    rm -f "$lease_path"
  fi
  exit 0
fi

case "$action" in
  start|status|restart|stop|doctor) ;;
  *) emit_error "Unsupported relay action: $action" 10 ;;
esac

if [[ "$target" == tunnel ]]; then
  [[ -x "$RELAY_TUNNEL_SCRIPT" ]] || emit_error 'Configured relay tunnel script was not found.' 10
  case "$action" in
    start) tunnel_action=start ;;
    status|doctor) tunnel_action=status ;;
    restart) tunnel_action=restart ;;
    stop) tunnel_action=stop ;;
  esac
  if $json; then "$RELAY_TUNNEL_SCRIPT" "$tunnel_action" --json; else "$RELAY_TUNNEL_SCRIPT" "$tunnel_action"; fi
  exit $?
fi

if [[ "$action" == status ]]; then
  result=$(relay_status_json) || emit_error 'Relay status failed.' 10
  state=$(jq -r '.State' <<< "$result")
  case "$state" in
    Ready) code=0 ;;
    Stopped) code=3 ;;
    Foreign|Conflict|Stale) code=6 ;;
    Unhealthy|DEGRADED) code=7 ;;
    *) code=10 ;;
  esac
  emit_result "$result" "$code"
fi

if [[ "$action" == doctor ]]; then
  status_json=$(relay_status_json) || emit_error 'Relay doctor failed.' 10
  anonymous=$(relay_anonymous_health_status)
  relay_probe >/dev/null 2>&1; probe_code=$?
  authenticated="Unhealthy"; version=""
  (( probe_code == 0 )) && authenticated="Ready" && version="$RELAY_PROBE_VERSION"
  tunnel_runtime="Stopped"
  [[ -x "$RELAY_TUNNEL_SCRIPT" ]] \
    && tunnel_runtime=$($RELAY_TUNNEL_SCRIPT status --json 2>/dev/null | jq -r '.Status // "Stopped"' 2>/dev/null)
  result=$(jq -cn --argjson status "$status_json" --argjson Port "$RELAY_PORT" \
    --arg AnonymousStatus "$( [[ "$anonymous" == 401 ]] && print Protected || [[ "$anonymous" == 000 ]] && print Unavailable || print Unexpected )" \
    --argjson AnonymousCode "$( [[ "$anonymous" == 000 ]] && print null || print "$anonymous" )" \
    --arg Authenticated "$authenticated" --arg Version "$version" --arg TunnelStatus "$tunnel_runtime" --arg TunnelScript "$RELAY_TUNNEL_SCRIPT" \
    '{Port:$Port,State:$status.State,Listener:$status.Backend.Status,Identity:$status.Backend.Status,Credentials:{Process:{Username:(if env.OPENCODE_SERVER_USERNAME then "SET" else "UNSET" end),Password:(if env.OPENCODE_SERVER_PASSWORD then "SET" else "UNSET" end)},User:{Username:"SET",Password:"SET"}},AnonymousHealth:{Status:$AnonymousStatus,StatusCode:$AnonymousCode},Authenticated:{Status:$Authenticated,Version:(if $Version=="" then null else $Version end)},Tunnel:{Status:$TunnelStatus,Script:$TunnelScript}}')
  emit_result "$result" 0
fi

relay_lock_acquire 20 || emit_error 'Relay mutex acquisition timed out.' 10
trap relay_lock_release EXIT

if [[ "$action" == start ]]; then
  current_state=$(relay_read_state 2>/dev/null || true)
  pids=(${(f)"$(relay_listener_pids)"})
  if [[ -n "$current_state" && "$(jq -r '.state' <<< "$current_state")" == READY ]]; then
    backend=$(jq -c '.backend' <<< "$current_state")
    if relay_backend_identity "$backend"; then emit_result "$(relay_status_json)" 0; fi
    if (( ${#pids[@]} > 0 )); then emit_error 'Relay ownership conflict: recorded state does not own the listener.' 6; fi
    generation=$(( $(jq -r '.generation' <<< "$current_state") + 1 ))
    relay_spawn_backend "$generation" || emit_error 'Relay backend start failed.' 7
    emit_result "$(relay_status_json)" 0
  fi
  if (( ${#pids[@]} > 0 )); then emit_error 'Relay ownership conflict: a listener already occupies the configured port.' 6; fi
  generation=1
  [[ -n "$current_state" ]] && generation=$(( $(jq -r '.generation' <<< "$current_state") + 1 ))
  relay_spawn_backend "$generation" || {
    code=$?
    (( code == 6 )) && emit_error 'Relay ownership conflict during backend start.' 6 \
      || emit_error 'Relay backend start failed.' 7
  }
  emit_result "$(relay_status_json)" 0
fi

current_state=$(relay_read_state 2>/dev/null || true)
pids=(${(f)"$(relay_listener_pids)"})

if [[ "$action" == restart && ( -z "$current_state" || "$(jq -r '.state' <<< "$current_state")" == STOPPED \
    || "$(jq -r '.state' <<< "$current_state")" == DEGRADED ) && ${#pids[@]} -eq 0 ]]; then
  generation=1
  [[ -n "$current_state" ]] && generation=$(( $(jq -r '.generation' <<< "$current_state") + 1 ))
  relay_spawn_backend "$generation" || emit_error 'Relay backend start failed.' 7
  emit_result "$(relay_status_json)" 0
fi

if [[ "$action" == stop && -n "$current_state" && "$(jq -r '.state' <<< "$current_state")" == STOPPED \
    && ${#pids[@]} -eq 0 ]]; then
  result=$(jq -cn --argjson Generation "$(jq -r '.generation' <<< "$current_state")" \
    '{State:"Stopped",Generation:$Generation,Warnings:[]}')
  emit_result "$result" 0
fi

[[ -n "$current_state" && "$(jq -r '.state' <<< "$current_state")" == READY ]] \
  || emit_error 'Relay ownership conflict: backend is not in READY state.' 6
backend=$(jq -c '.backend' <<< "$current_state")
relay_backend_identity "$backend" || emit_error "Relay ownership conflict: backend is $RELAY_IDENTITY_STATUS." 6
generation=$(jq -r '.generation' <<< "$current_state")
transition=STOPPING
[[ "$action" == restart ]] && transition=RESTARTING
relay_write_state "$transition" "$generation" "$backend" || emit_error 'Relay state write failed.' 10

if ! relay_client_shutdown "$generation"; then
  relay_write_state DEGRADED "$generation" "$backend" 'Relay ownership conflict.'
  emit_error 'Relay ownership conflict: client lease changed before stop.' 6
fi

relay_backend_identity "$backend" || {
  relay_write_state DEGRADED "$generation" "$backend" 'Relay ownership conflict.'
  emit_error 'Relay ownership conflict: backend identity drifted before stop.' 6
}
relay_kill_verified_group "$(jq -c '{pid,created,executable,parentPid,pgid}' <<< "$backend")" 3 || {
  relay_write_state DEGRADED "$generation" "$backend" 'Relay backend stop failed.'
  emit_error 'Relay backend stop failed.' 7
}
if ! relay_wait_port_free 10; then
  relay_write_state DEGRADED "$generation" null 'Relay lifecycle deadline expired.'
  emit_error 'Relay lifecycle deadline expired while waiting for the port to become free.' 7
fi

if [[ "$action" == stop ]]; then
  relay_write_state STOPPED "$generation" null
  emit_result "$(jq -cn --argjson Generation "$generation" '{State:"Stopped",Generation:$Generation,Warnings:[]}')" 0
fi

relay_spawn_backend "$(( generation + 1 ))" || {
  relay_write_state DEGRADED "$generation" null 'Replacement backend failed to become healthy.'
  emit_error 'Replacement backend failed to become healthy.' 7
}
emit_result "$(relay_status_json)" 0
